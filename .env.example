# Required: your Anthropic API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: put the app behind a password (browser login prompt, any username).
# Recommended if the app is reachable from the internet, since every new recipe uses your API credits.
APP_PASSWORD=

# Optional: Claude model and effort level (low | medium | high | xhigh | max)
RECIPE_MODEL=claude-opus-5-5
RECIPE_EFFORT=medium

# Optional: host port for docker compose
PORT=8000
